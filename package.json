{
  "name": "corkboard",
  "productName": "Corkboard",
  "version": "1.1.0",
  "description": "A pinboard for your desktop that feels like the real thing.",
  "desktopName": "corkboard.desktop",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron . --no-sandbox",
    "app": "electron . --no-sandbox",
    "test": "node --test tests/*.test.mjs && vite build && electron scripts/e2e.cjs --no-sandbox",
    "test:unit": "node --test tests/*.test.mjs",
    "dist": "vite build && electron-builder --linux deb rpm --publish never",
    "shots": "vite build && electron scripts/shots.cjs --no-sandbox",
    "dist:deb": "vite build && electron-builder --linux deb --publish never"
  },
  "keywords": [
    "corkboard",
    "pinboard",
    "notes",
    "sticky-notes",
    "markdown",
    "electron",
    "linux"
  ],
  "author": {
    "name": "Kabir Raval",
    "email": "90386971+Kabramba@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "dompurify": "^3.4.17",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "highlight.js": "^11.12.0",
    "idb-keyval": "^6.3.0",
    "katex": "^0.18.10",
    "marked": "^18.2.0",
    "marked-katex-extension": "^5.1.13",
    "pdfjs-dist": "^6.5.438",
    "vite": "^8.3.8"
  },
  "homepage": "https://github.com/Kabramba/corkboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kabramba/corkboard.git"
  },
  "bugs": {
    "url": "https://github.com/Kabramba/corkboard/issues"
  },
  "build": {
    "appId": "io.github.kabramba.corkboard",
    "productName": "Corkboard",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Office",
      "icon": "build/icons",
      "executableName": "corkboard",
      "synopsis": "A pinboard for your desktop that feels like the real thing",
      "description": "Sticky notes, cards, Markdown paper, photos, PDF pages and code on an endless cork surface, held with pins, tape and yarn.",
      "maintainer": "Kabir Raval <90386971+Kabramba@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "Corkboard",
          "Keywords": "notes;sticky;pinboard;corkboard;markdown;",
          "StartupWMClass": "corkboard"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "corkboard_${version}_${arch}.deb"
    },
    "rpm": {
      "artifactName": "corkboard-${version}.${arch}.rpm"
    }
  }
}
